# Локальные настройки. Скопируйте файл в .env и заполните пустые поля.
# В git этот файл с секретами не коммитится.

# --- Приложение ---
# local — разработка, prod — сервер.
DJANGO_SETTINGS_MODULE=config.settings.local
# Сгенерировать: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
DJANGO_SECRET_KEY=
# С каких хостов открывать сайт. На сервере: market-kod.ru,www.market-kod.ru
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# Откуда браузер шлёт формы. На сервере: https://market-kod.ru
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000
# Если фронт на другом порту. Для того же Django можно не трогать.
DJANGO_CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000
DJANGO_LOG_LEVEL=INFO

# --- База ---
POSTGRES_DB=bulletin_board
POSTGRES_USER=bulletin_board
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# --- Вход по JWT ---
# Access: 15–60 минут (по умолчанию 60); refresh: 1–7 дней (по умолчанию 7).
JWT_ACCESS_TTL_MINUTES=60
JWT_REFRESH_TTL_DAYS=7

# --- Почта ---
# console — письма в терминал. На сервере укажите smtp.
DJANGO_EMAIL_BACKEND=console
DJANGO_EMAIL_HOST=
DJANGO_EMAIL_PORT=465
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_EMAIL_USE_SSL=true
DJANGO_EMAIL_USE_TLS=false
DJANGO_EMAIL_TIMEOUT=10
DJANGO_DEFAULT_FROM_EMAIL=noreply@market-kod.ru

# Ссылки в письмах (регистрация, сброс пароля, «объявление опубликовано»).
# На сервере: https://market-kod.ru
FRONTEND_URL=http://127.0.0.1:8000

# --- Docker ---
WEB_PORT=8000
# Сколько секунд ждать базу при старте контейнера.
DATABASE_WAIT_TIMEOUT=60
# Хост для проверки «живой ли сайт». Должен быть в DJANGO_ALLOWED_HOSTS.
HEALTHCHECK_HOST=localhost

# --- Только для config.settings.prod ---
POSTGRES_CONN_MAX_AGE=60
POSTGRES_CONNECT_TIMEOUT=2
POSTGRES_SSLMODE=prefer
DJANGO_SERVER_EMAIL=noreply@market-kod.ru
# Браузер запомнит HTTPS на год.
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=true
DJANGO_SECURE_HSTS_PRELOAD=true
# true, если HTTPS заканчивается на nginx / прокси.
DJANGO_BEHIND_TLS_PROXY=true

# На сервере обязательно:
# точные домены в DJANGO_ALLOWED_HOSTS,
# https://market-kod.ru в CSRF и FRONTEND_URL,
# SMTP вместо console.

# --- Кэш ---
# Compose по умолчанию использует общий кэш в Postgres для лимитов сообщений и писем.
# Таблица message_rate_cache создаётся при старте контейнера, повторный запуск безопасен.
# Без Docker по умолчанию — память процесса. Для нескольких процессов задайте общий кэш
# и выполните python manage.py createcachetable до запуска приложения.
# DJANGO_CACHE_URL=database://message_rate_cache
